# Canonical Production Site URL (used for metadataBase, sitemap, robots, OG tags)
NEXT_PUBLIC_SITE_URL=https://zenithdigitalstudio.vercel.app

# Firebase Client SDK Configuration (Optional - portfolio falls back to local JSON cache if omitted)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Hardened Secret-URL Admin CMS Token (Timing-safe validated)
# Visiting /admin returns 404 (notFound). The CMS dashboard is ONLY accessible via:
# https://your-domain.com/admin/[ADMIN_SECRET_TOKEN]
ADMIN_SECRET_TOKEN=your-ultra-secret-url-token-here
NEXT_PUBLIC_ADMIN_SECRET_TOKEN=your-ultra-secret-url-token-here

# Studio Contact Lead Webhook (Discord / Slack / Telegram / Make)
# Automatically dispatches rich notification embeds for high-converting lead captures
CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Studio Public Contact Details
NEXT_PUBLIC_CONTACT_EMAIL=zeniithdigitalworks@gmail.com
NEXT_PUBLIC_CONTACT_PHONE="+91 63535 84747"
NEXT_PUBLIC_WHATSAPP_NUMBER=916353584747

# Optional Resend Email Delivery API (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
CONTACT_RECEIVER_EMAIL=zeniithdigitalworks@gmail.com

# Google Search Console Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code-here
